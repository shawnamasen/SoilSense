# Create frontend/.env locally (not committed) or set Vercel environment variables.
# Copy the WEB app config from Firebase Console -> Project settings -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only if running the standalone backend API.
# VITE_API_URL=http://localhost:5000/api
